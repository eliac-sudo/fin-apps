{
  "version": "vol_bot_v1",
  "frozen": "2026-11-23",
  "network_default": "test",
  "structure": "put spread venduto: vendi la put vicina a short_delta, compri l'ala vicina a long_delta, stessa scadenza",
  "books": [
    {"name": "btc_usdc", "underlying": "BTC", "settlement": "USDC", "enabled": true},
    {"name": "btc_btc", "underlying": "BTC", "settlement": "BTC", "enabled": true},
