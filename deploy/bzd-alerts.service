[Unit]
Description=BZD alerts and bot
After=network-online.target
Wants=network-online.target

[Service]
User=bzd
WorkingDirectory=/opt/bzd
ExecStart=/opt/bzd/.venv/bin/python -u -m bzd.alerts run
Restart=always
RestartSec=30
StandardOutput=append:/opt/bzd/data/alerts.log
StandardError=append:/opt/bzd/data/alerts.log

[Install]
WantedBy=multi-user.target
