[Unit]
Description=BZD recorder
After=network-online.target
Wants=network-online.target

[Service]
User=bzd
WorkingDirectory=/opt/bzd
ExecStart=/opt/bzd/.venv/bin/python -u -m bzd.recorder run
Restart=always
RestartSec=30
StandardOutput=append:/opt/bzd/data/recorder.log
StandardError=append:/opt/bzd/data/recorder.log

[Install]
WantedBy=multi-user.target
