[Unit]
Description=BZD Hyperliquid wallets
After=network-online.target
Wants=network-online.target

[Service]
User=bzd
WorkingDirectory=/opt/bzd
ExecStart=/opt/bzd/.venv/bin/python -u -m bzd.wallets run
Restart=always
RestartSec=30
StandardOutput=append:/opt/bzd/data/wallets.log
StandardError=append:/opt/bzd/data/wallets.log

[Install]
WantedBy=multi-user.target
